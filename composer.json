{
    "name": "humam-k98/laravel-filters",
    "description": "Laravel 8+ filtering toolkit using builder pattern",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filter",
        "eloquent",
        "query-builder",
        "search",
        "filtering",
        "api-filters",
        "query-parameters"
    ],
    "homepage": "https://github.com/humam-k98/laravel-filters",
    "authors": [
        {
            "name": "Humam kerdiah",
            "email": "humamkerdiah97@gmail.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "HumamK98\\LaravelFilters\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HumamK98\\LaravelFilters\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^7.4|^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0",
        "phpunit/phpunit": "^9.0|^10.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "HumamK98\\LaravelFilters\\LaravelFiltersServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}